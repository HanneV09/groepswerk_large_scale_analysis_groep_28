library(ggplot2)
library(dplyr)
ggplot(data_cxcl13,
aes(x = visit,
y = CXCL13,
group = donor,
color = age_group)) +
geom_line(alpha = 0.35, linewidth = 0.5) +
geom_point(size = 2, alpha = 0.75) +
stat_summary(
aes(group = age_group),
fun = mean,
geom = "line",
linewidth = 1.3
) +
stat_summary(
aes(group = age_group),
fun = mean,
geom = "point",
size = 3
) +
labs(
title = "Individual CXCL13 changes between Day 0 and Day 7",
x = "Visit",
y = "CXCL13",
color = "Age group"
) +
theme_classic()
