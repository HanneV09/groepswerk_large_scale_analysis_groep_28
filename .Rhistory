analysis_data <- subset(
data,
sample.visitName %in% c(
"Flu Year 1 Day 0",
"Flu Year 1 Day 7"
)
)
table(analysis_data$sample.visitName)
library(dplyr)
library(lme4)
library(lmerTest)
#meetmomenten omzetten naar categorische variable, Dit zorgt ervoor dat R de visit als een categorie behandelt, en niet als een numerieke waarde.
analysis_data <- analysis_data %>%
mutate(
visit = factor(sample.visitName,
levels = c("Flu Year 1 Day 0", "Flu Year 1 Day 7"),
labels = c("Day 0", "Day 7")),
#De code stelt de volgorde van de categorieën vast.
age_group = factor(subject.ageGroup, levels = c("Young Adult", "Older Adult")),
#Andere variabelen omzetten naar factoren omdat ze in het statistisch model als groepen of categorieën moeten         worden behandeld, en niet als numerieke waarden.
sex = factor(subject.biologicalSex),
cmv_status = factor(cmv_status),
batch = factor(olink_batch_id),
donor = factor(subject.subjectGuid)
#filteren = de code verwijdert alle rijen waarin minstens één van deze variabelen ontbreekt:
) %>%
filter(
!is.na(CXCL13),
!is.na(visit),
!is.na(age_group),
!is.na(sex),
!is.na(cmv_status),
!is.na(batch),
!is.na(donor)
)
# Controleer de aantallen per bezoek en leeftijdsgroep= je controleert hoeveel observaties er per visit en leeftijdsgroep overblijven.
table(Visit = analysis_data$visit, AgeGroup = analysis_data$age_group)
model_protein_cxcl13 <- lmer(
CXCL13 ~ visit * age_group + sex + cmv_status + batch + (1 | donor),
data = analysis_data
)
summary(model_protein_cxcl13)
plot(fitted(model_cxcl13), resid(model_cxcl13),
xlab = "Fitted values", ylab = "Residuals",
main = "Residuals vs Fitted")
abline(h = 0, lty = 2, col = "pink")
qqnorm(resid(model_cxcl13), main = "Q-Q Residuals")
qqline(resid(model_cxcl13), col = "red")
# 3. Normaliteit van random intercepts (donor)Je controleert of de random intercepts van de 92 donoren ongeveer normaal verdeeld zijn.
qqnorm(unlist(ranef(model_cxcl13)$donor), main = "Q-Q Random Intercepts")
qqline(unlist(ranef(model_cxcl13)$donor), col = "red")
par(mfrow = c(1, 1))
library(ggplot2)
library(dplyr)
library(ggplot2)
library(dplyr)
# Haal de data uit het mixed model
data_cxcl13 <- model.frame(model_cxcl13)
# Maak de paired plot
ggplot(data_cxcl13,
aes(x = visit,
y = CXCL13,
group = donor,
color = age_group)) +
geom_line(alpha = 0.35, linewidth = 0.5) +
geom_point(size = 2, alpha = 0.75) +
stat_summary(
aes(group = age_group),
fun = mean,
geom = "line",
linewidth = 1.3
) +
stat_summary(
aes(group = age_group),
fun = mean,
geom = "point",
size = 3
) +
labs(
title = "Individual CXCL13 changes between Day 0 and Day 7",
x = "Visit",
y = "CXCL13",
color = "Age group"
) +
theme_classic()
